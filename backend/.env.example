DATABASE_URL=postgresql+psycopg:///casting_intelligence
APP_NAME=The Working Actor OS API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./storage/uploads
DURABLE_FILE_STORAGE_ENABLED=
TRAVEL_PROVIDER=manual
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
OPENROUTESERVICE_API_KEY=
TRAVEL_CACHE_DAYS=30
OPENAI_API_KEY=
WEB_SEARCH_PROVIDER=none
PARALLEL_API_KEY=
SCHEDULER_ENABLED=false
NOTIFICATIONS_ENABLED=false
PUBLIC_PROFILE_IMPORT_ENABLED=true
SUPERVISED_BROWSER_ENABLED=true

# Sanitized portfolio-demo deployment overrides:
# ENVIRONMENT=portfolio_demo
# CORS_ORIGINS=https://replace-with-your-frontend-origin.example
# PUBLIC_PROFILE_IMPORT_ENABLED=false
# SUPERVISED_BROWSER_ENABLED=false
# DURABLE_FILE_STORAGE_ENABLED=false
# Keep provider keys empty and TRAVEL_PROVIDER=manual, WEB_SEARCH_PROVIDER=none,
# SCHEDULER_ENABLED=false, and NOTIFICATIONS_ENABLED=false.
